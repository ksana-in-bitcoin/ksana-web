{
  "name": "@ksana/web",
  "version": "0.1.0",
  "private": true,
  "description": "Ksana web wallet and block explorer: an in-browser devnet simulator, or a node connected over JSON-RPC",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "check:build-context": "node scripts/check-build-context.mjs",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:artifact": "vite build --mode artifact && node scripts/inline-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@ksana/sdk": "file:core/sdk/ts",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
